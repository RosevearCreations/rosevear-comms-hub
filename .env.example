# QL-028 placeholder only. Do not put real credentials, phone numbers, webhook secrets, payloads, recordings, transcripts, or customer data in this file.

APP_ENV=development
APP_NAME=rosevear-comms-hub
VITE_DEFAULT_BRAND=rosiedazzlers
VITE_STORAGE_KEY=rosevear-comms-hub:v1

# Supabase/Postgres settings.
# Project URL is public, but keys/connection strings are not filled in yet.
# Do not commit real service-role keys, database passwords, JWT secrets, or connection strings.
DATABASE_PROVIDER=supabase
SUPABASE_PROJECT_REF=gxujcwpktaickcgzyvnu
VITE_SUPABASE_URL=https://gxujcwpktaickcgzyvnu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_SSL_MODE=require
DATABASE_READONLY_URL=

# Auth/session feature gates.
# Keep false until the deployed environment has the publishable key and you are ready to test login.
AUTH_PROVIDER=supabase
AUTH_ADMIN_EMAILS=
ENABLE_HOSTED_DATABASE=false
VITE_ENABLE_HOSTED_DATABASE=false
VITE_ENABLE_SUPABASE_CLIENT=false
VITE_ENABLE_SUPABASE_LOGIN=false
VITE_ENABLE_SUPABASE_LIVE_READS=false
VITE_ENABLE_SUPABASE_LIVE_WRITES=false

# Protected website intake endpoint.
# Server-side only. Do not prefix server secrets with VITE_.
ENABLE_PROTECTED_INTAKE_ENDPOINT=false
ENABLE_INTAKE_PERSISTENCE=false
ENABLE_RATE_LIMITING=false
ENABLE_INTAKE_IDEMPOTENCY=false
DEPLOYMENT_TARGET=vercel
DEPLOYMENT_RUNTIME_WRAPPER=vercel_serverless_function
PROTECTED_INTAKE_PREVIEW_ROUTE=/api/intake
PROTECTED_INTAKE_DRY_RUN_EXPECTED_MODE=disabled
PROTECTED_INTAKE_DISABLED_MODE_EXPECTED_STATUS=503
PROTECTED_INTAKE_DISABLED_MODE_EXPECTED_MODE=disabled
PROTECTED_INTAKE_ENABLEMENT_GATE_STATUS=hold
PROTECTED_INTAKE_ENABLEMENT_ALLOWED=false
PROTECTED_INTAKE_PREVIEW_URL=
ALLOWED_INTAKE_ORIGINS=https://rosiedazzlers.ca,https://devilndove.com,https://devilndove.online
INTAKE_SHARED_SECRET=

# Phone/SMS disabled dry-run runtime verification path.
# Do not port or forward existing numbers during QL-028.
# Do not configure provider webhooks or enable live phone/SMS features during QL-028.
# Do not paste provider credentials, actual candidate numbers, purchased numbers, ownership documents, invoices, screenshots, customer data, live payloads, call recordings, transcripts, webhook secret values, or existing phone numbers here.
