{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RosevearCreations/rosevear-comms-hub/blob/main/api/contracts/ql485-source-release-notice-v1.schema.json",
  "title": "QL-485 Source Signed Release Notice (metadata only)",
  "description": "Signature covers canonical recursively sorted JSON payload; valid notice is NEVER source enrollment, network permission, or customer access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "noticeId",
        "sourceId",
        "repository",
        "sourceRevision",
        "previousRevision",
        "manifestMajor",
        "contractVersion",
        "eventSchemas",
        "capabilities",
        "tenantBoundary",
        "environment",
        "audience",
        "issuedAtMs",
        "expiresAtMs",
        "requestedAction",
        "customerDataIncluded",
        "authorityTransfer"
      ],
      "properties": {
        "schema": {
          "const": "rosevear.comms.ql485.source-release-notice.v1"
        },
        "noticeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,96}$"
        },
        "sourceId": {
          "enum": [
            "yw",
            "icamp",
            "rosiedazzlers",
            "devilndove",
            "ai-data-platform",
            "rosevear-ai-hub"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^RosevearCreations/[A-Za-z0-9_-]{2,64}$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "previousRevision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        },
        "manifestMajor": {
          "const": 1
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "eventSchemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,96}$"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,96}$"
          }
        },
        "tenantBoundary": {
          "enum": [
            "platform_shell",
            "owned_business_legacy",
            "no_customer_tenant"
          ]
        },
        "environment": {
          "enum": [
            "TEST",
            "PRIVATE_STAGING"
          ]
        },
        "audience": {
          "const": "rosevear-comms-hub:private-negotiation"
        },
        "issuedAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "requestedAction": {
          "const": "READ_ONLY_COMPATIBILITY_REVIEW"
        },
        "customerDataIncluded": {
          "const": false
        },
        "authorityTransfer": {
          "const": false
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
