// AIDP Build 432 canonical-envelope Workers redeploy trigger; no configuration behavior change.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rosevear-comms-hub",
  "main": "./worker/build432-sysop-telemetry.js",
  "compatibility_date": "2026-11-21",
  "previews": {},
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/internal/rosevear/sysop/telemetry/*"]
  },
  "durable_objects": {
    "bindings": [
      {"name":"BUILD432_SIGNER","class_name":"Build432Signer"}
    ]
  },
  "exports": {
    "Build432Signer": {"type":"durable-object","storage":"sqlite"}
  }
}
